---
import type { Locale } from "../data/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { experiences, ui } = locale;
---

<section id="experience">
  <div class="container">
    <span class="eyebrow" data-reveal>{ui.experience.eyebrow}</span>
    <h2 data-reveal>{ui.experience.heading}</h2>

    <div class="timeline" data-timeline>
      <div class="timeline-track">
        <span class="timeline-line" data-timeline-line></span>
      </div>

      <ol class="timeline-list">
        {experiences.map((exp) => (
          <li class="timeline-entry" data-reveal>
            <span class="timeline-dot" class:list={[{ "timeline-dot-current": exp.current }]}></span>
            <div class="card experience-card" data-expand-card data-expand-whole data-open="false">
              <button
                class="experience-header"
                data-expand-toggle
                aria-expanded="false"
              >
                <div>
                  <p class="experience-period">
                    {exp.period}
                    {exp.current && <span class="tag experience-tag">{ui.experience.currentTag}</span>}
                  </p>
                  <h3>{exp.company}</h3>
                  <p class="experience-role text-muted">{exp.role}</p>
                </div>
                <span class="experience-icon" aria-hidden="true">+</span>
              </button>

              <p class="experience-context text-muted">{exp.context}</p>

              <div class="experience-details" data-expand-details>
                <ul>
                  {exp.highlights.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
                <div class="skill-tags">
                  {exp.stack.map((tech) => (
                    <span class="pill">{tech}</span>
                  ))}
                </div>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
  }

  .timeline-track {
    position: relative;
  }

  .timeline-track::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-border);
    transform: translateX(-50%);
  }

  .timeline-line {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-accent);
    transform: translateX(-50%) scaleY(0);
  }

  .timeline-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }

  .timeline-entry {
    position: relative;
  }

  .timeline-dot {
    position: absolute;
    left: -2.5rem;
    top: 1.75rem;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 999px;
    background: var(--color-text-faint);
    border: 2px solid var(--color-bg);
    box-shadow: 0 0 0 2px var(--color-border);
    transform: translateX(calc(-50% - 1px));
  }

  .timeline-dot-current {
    background: var(--color-accent);
    box-shadow: 0 0 0 2px var(--color-accent-soft);
  }

  .experience-card {
    padding: 1.5rem 1.75rem;
    cursor: pointer;
  }

  .experience-header {
    width: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    background: none;
    border: none;
    padding: 0;
    text-align: left;
    cursor: pointer;
    font: inherit;
    color: inherit;
  }

  .experience-period {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.35rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .experience-tag {
    padding: 0.1rem 0.6rem;
    font-size: 0.7rem;
  }

  .experience-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.15rem;
  }

  .experience-role {
    font-size: 0.95rem;
  }

  .experience-icon {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    color: var(--color-accent-strong);
    transition: transform 0.3s ease, background 0.2s ease;
  }

  [data-open="true"] .experience-icon {
    transform: rotate(45deg);
    background: var(--color-accent-soft);
  }

  .experience-context {
    margin-top: 1rem;
    font-size: 0.92rem;
  }

  .experience-details {
    margin-top: 1rem;
  }

  .experience-details ul {
    margin: 0 0 1rem;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.4rem;
  }

  .experience-details li {
    font-size: 0.92rem;
    color: var(--color-text-muted);
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (max-width: 640px) {
    .timeline {
      grid-template-columns: 1.5rem 1fr;
    }

    .timeline-dot {
      left: -1.5rem;
    }
  }
</style>
