---
import type { Locale } from "../data/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { projects, ui } = locale;
---

<section id="projects">
  <div class="container">
    <span class="eyebrow" data-reveal>{ui.projects.eyebrow}</span>
    <h2 data-reveal>{ui.projects.heading}</h2>

    <div class="projects-grid" data-reveal-group>
      {projects.map((project) => (
        <article class="card project-card" data-reveal-item>
          <span class="eyebrow">{project.company}</span>
          <h3>{project.title}</h3>
          <p class="text-muted project-pitch">{project.pitch}</p>
          <p class="project-highlight">{project.highlight}</p>
          <div class="skill-tags">
            {project.stack.map((tech) => (
              <span class="pill">{tech}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .project-card h3 {
    font-size: 1.3rem;
  }

  .project-pitch {
    font-size: 0.95rem;
  }

  .project-highlight {
    font-size: 0.9rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-border);
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }
</style>
