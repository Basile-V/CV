---
import type { Locale } from "../data/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { profile, ui } = locale;
---

<section id="top" class="hero">
  <div class="container hero-inner">
    <span class="eyebrow" data-hero-item>{profile.level}</span>
    <h1 data-hero-item>
      {ui.hero.greeting} <span class="accent">{profile.name}</span>.
    </h1>
    <p class="hero-title" data-hero-item>{profile.title}</p>
    <p class="hero-tagline text-muted" data-hero-item>{profile.tagline}</p>
    <div class="hero-cta" data-hero-item>
      <a class="button" href="#experience">{ui.hero.ctaPrimary}</a>
      <a class="button button-ghost" href="#contact">{ui.hero.ctaSecondary}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(4rem, 14vw, 8rem) clamp(3rem, 8vw, 5rem);
  }

  .hero-inner {
    max-width: 760px;
  }

  h1 {
    font-size: clamp(2.4rem, 6vw, 4rem);
    margin-block: 0 0.5rem;
  }

  .accent {
    color: var(--color-accent);
  }

  .hero-title {
    font-size: clamp(1.1rem, 2.2vw, 1.4rem);
    font-weight: 600;
    margin-bottom: 1.25rem;
  }

  .hero-tagline {
    font-size: 1.05rem;
    max-width: 56ch;
    margin-bottom: 2.25rem;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
