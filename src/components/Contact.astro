---
import type { Locale } from "../data/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { contactLinks, ui } = locale;
---

<section id="contact">
  <div class="container contact-inner" data-reveal>
    <span class="eyebrow">{ui.contact.eyebrow}</span>
    <h2>{ui.contact.heading}</h2>
    <p class="text-muted contact-text">{ui.contact.text}</p>
    <div class="contact-links">
      {contactLinks.map((link) => (
        <a class="button" href={link.href}>{link.label}</a>
      ))}
    </div>
  </div>
</section>

<style>
  .contact-inner {
    max-width: 640px;
    text-align: center;
    margin-inline: auto;
  }

  .contact-text {
    margin-block: 1rem 2rem;
    font-size: 1.05rem;
  }

  .contact-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
